<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:theme="@style/Theme.NotaMusic"
        android:label="NotaMusic"
        android:icon="@drawable/ic_notamusic"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:resizeableActivity="true">
        <activity android:name=".ui.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".ui.ScoreCreationActivity" android:exported="false"/>
        <activity android:name=".ui.OpenScoresActivity" android:exported="false"/>
        <activity android:name=".ui.SettingsActivity" android:exported="false"/>
        <activity android:name=".ui.MetadataEditorActivity" android:exported="false"/>
        <activity android:name=".ui.EditScoreActivity" android:exported="false"/>
        <activity android:name=".ui.StaffConfigurationActivity" android:exported="false"/>
        <activity android:name=".ui.ShareScoreActivity" android:exported="false"/>
    </application>
</manifest>
